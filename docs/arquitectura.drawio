<mxfile host="tpo-holograma">
  <diagram id="arquitectura" name="Arquitectura">
    <mxGraphModel dx="1600" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="titulo" value="Visor 3D controlado con gestos y generado por IA — arquitectura" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="900" height="40" as="geometry" /></mxCell>
        <mxCell id="z_nav" value="Navegador del usuario · el video nunca sale de acá" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#f4fbfe;strokeColor=#2bd4ff;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="1560" height="350" as="geometry" /></mxCell>
        <mxCell id="z_back" value="Backend local (FastAPI)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#666666;dashed=0;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="20" y="480" width="1130" height="320" as="geometry" /></mxCell>
        <mxCell id="z_ext" value="Servicios externos (opcionales)" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#fff7f7;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1180" y="480" width="400" height="320" as="geometry" /></mxCell>
        <mxCell id="cam" value="Cámara web" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="120" height="60" as="geometry" /></mxCell>
        <mxCell id="mp" value="&lt;b&gt;MediaPipe Hand Landmarker&lt;/b&gt; [1]&lt;br&gt;21 puntos por mano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="190" y="110" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="norm" value="Normalización&lt;br&gt;origen en la muñeca,&lt;br&gt;escala de la mano" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="105" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="cls" value="&lt;b&gt;Clasificador de gestos&lt;/b&gt; [2]&lt;br&gt;reglas (o MLP) · confianza =&lt;br&gt;votos de 6 fotogramas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="105" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="dec" value="confianza&lt;br&gt;≥ 0,8" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="830" y="100" width="110" height="80" as="geometry" /></mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;Controles&lt;/b&gt;&lt;br&gt;mover · rotar · escalar · reiniciar&lt;br&gt;+ historial (Deshacer)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="105" width="200" height="70" as="geometry" /></mxCell>
        <mxCell id="visor" value="&lt;b&gt;Visor Three.js&lt;/b&gt;&lt;br&gt;carga el .glb, lo centra&lt;br&gt;y suaviza el movimiento" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1240" y="105" width="180" height="70" as="geometry" /></mxCell>
        <mxCell id="over" value="Recuadro de detección&lt;br&gt;esqueleto + gesto (cian = se aplica,&lt;br&gt;ámbar = solo detectado)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="610" y="215" width="190" height="70" as="geometry" /></mxCell>
        <mxCell id="alt" value="Botones y teclado&lt;br&gt;(control alternativo)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="970" y="225" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="salida" value="El usuario ve el modelo y su origen&lt;br&gt;(del catálogo o generado por IA, no apto&lt;br&gt;para fabricación), el gesto con su&lt;br&gt;confianza y lo que se entendió del pedido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a8fb0;strokeColor=#0e5f75;fontColor=#ffffff;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1240" y="225" width="320" height="95" as="geometry" /></mxCell>
        <mxCell id="txt" value="Pedido escrito&lt;br&gt;&lt;i&gt;&quot;mostrame una válvula&quot;&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="140" height="60" as="geometry" /></mxCell>
        <mxCell id="orq" value="&lt;b&gt;Orquestador&lt;/b&gt; (main.js)&lt;br&gt;muestra lo entendido; pide&lt;br&gt;confirmación si confianza &amp;lt; 0,5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="210" y="310" width="210" height="80" as="geometry" /></mxCell>
        <mxCell id="local" value="Plan B si el backend no responde:&lt;br&gt;búsqueda local en el catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="470" y="320" width="210" height="60" as="geometry" /></mxCell>
        <mxCell id="llm" value="&lt;b&gt;Intérprete con LLM&lt;/b&gt; [3]&lt;br&gt;salida con JSON Schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="reg" value="Intérprete por reglas&lt;br&gt;(respaldo: sin clave o sin red)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;dashed=1;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="630" width="190" height="60" as="geometry" /></mxCell>
        <mxCell id="safe" value="&lt;b&gt;Validación&lt;/b&gt; [6]&lt;br&gt;esquema (Pydantic) · objetos fuera&lt;br&gt;del dominio · límites · pedidos&lt;br&gt;por minuto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="270" y="565" width="210" height="90" as="geometry" /></mxCell>
        <mxCell id="busq" value="&lt;b&gt;Búsqueda híbrida&lt;/b&gt; [5]&lt;br&gt;1) palabras clave&lt;br&gt;2) embeddings MiniLM (umbral 0,62)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="530" width="220" height="80" as="geometry" /></mxCell>
        <mxCell id="dec2" value="¿está en el&lt;br&gt;catálogo?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;fontSize=11;" vertex="1" parent="1"><mxGeometry x="780" y="530" width="120" height="80" as="geometry" /></mxCell>
        <mxCell id="cat" value="Catálogo&lt;br&gt;catalogo.json + .glb" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="520" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="gen" value="&lt;b&gt;generate3d.py + ensamble.py&lt;/b&gt; [4]&lt;br&gt;por piezas con Claude o con Colab ·&lt;br&gt;valida · lo guarda en el catálogo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="680" width="200" height="75" as="geometry" /></mxCell>
        <mxCell id="nota_back" value="Un modelo generado queda en el catálogo: el próximo pedido parecido sale al instante (reutilización, sección 4) y sigue marcado como &quot;generado por IA&quot;." style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="720" width="640" height="40" as="geometry" /></mxCell>
        <mxCell id="anth" value="&lt;b&gt;Claude (Anthropic)&lt;/b&gt;&lt;br&gt;solo recibe el texto del pedido" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="530" width="340" height="60" as="geometry" /></mxCell>
        <mxCell id="colab" value="&lt;b&gt;Servidor de generación&lt;/b&gt; (Colab, GPU) [4]&lt;br&gt;SDXL-Turbo → TripoSR, o Shap-E · túnel con contraseña" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1210" y="680" width="340" height="75" as="geometry" /></mxCell>
        <mxCell id="leyenda" value="&lt;b&gt;Técnicas de IA (sección 5.7)&lt;/b&gt;&lt;br&gt;[1] visión por computadora · [2] reglas + MLP · [3] LLM · [4] IA generativa 3D · [5] embeddings y búsqueda · [6] reglas de seguridad&lt;br&gt;&lt;b&gt;Colores:&lt;/b&gt; azul = modelo de IA · amarillo = reglas · verde = datos · gris = interfaz · rojo punteado = servicio externo · borde punteado = respaldo si algo falla" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=11;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="815" width="1560" height="50" as="geometry" /></mxCell>
