# Copiar a .env y completar. Nunca subir .env al repositorio.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Generación 3D de lo que no está en el catálogo:
#   auto        = por piezas con el LLM si hay ANTHROPIC_API_KEY; si no, Colab si hay GEN3D_URL
#   ensamble    = el LLM diseña el objeto por piezas (sin GPU; las piezas se pueden desmontar)
#   remoto      = TripoSR o Shap-E en Colab (backend/generador_colab/servidor_generacion.ipynb)
#   desactivado = los pedidos se resuelven solo con el catálogo
GEN3D_MODO=auto
GEN3D_URL=
GEN3D_TOKEN=
SIMILARITY_THRESHOLD=0.62
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Sin internet el día de la defensa: usar el modelo de embeddings de la caché sin consultar Hugging Face
# HF_HUB_OFFLINE=1
# Pedidos por minuto por cliente (sección 16.5). Para medir latencias: LIMITE_PEDIDOS_MINUTO=1000
# LIMITE_PEDIDOS_MINUTO=30
