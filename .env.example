# Copiar a .env y completar. Nunca subir .env al repositorio.
ANTHROPIC_API_KEY=
LLM_MODEL=
# Generación 3D: servidor en Colab (backend/generador_colab/servidor_generacion.ipynb).
# Dejar GEN3D_MODO=desactivado si no se usa: los pedidos se resuelven solo con el catálogo.
GEN3D_MODO=desactivado
GEN3D_URL=
GEN3D_TOKEN=
SIMILARITY_THRESHOLD=0.62
EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# Sin internet el día de la defensa: usar el modelo de embeddings de la caché sin consultar Hugging Face
# HF_HUB_OFFLINE=1
